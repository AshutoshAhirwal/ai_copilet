<?php

/**
 * @file
 * Primary module hooks for Drupal AI Copilot.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_page_attachments().
 */
function ai_copilot_page_attachments(array &$page) {
  $account = \Drupal::currentUser();
  if (!$account->hasPermission('use ai copilot')) {
    return;
  }

  $config = \Drupal::config('ai_copilot.settings');
  $developerMode = (bool) $config->get('developer_mode');
  if (!$developerMode) {
    return;
  }

  /** @var \Drupal\ai_copilot\Service\EnvironmentDetectorService $envDetector */
  $envDetector = \Drupal::service('ai_copilot.environment_detector');
  $isProduction = $envDetector->isProduction();

  $csrf = \Drupal::csrfToken();
  $headerCsrfToken = $csrf->get('X-CSRF-Token request header');

  $page['#attached']['library'][] = 'ai_copilot/chat_panel';
  $page['#attached']['drupalSettings']['aiCopilot'] = [
    'chatApiUrl' => '/admin/api/ai-copilot/chat',
    'streamApiUrl' => '/admin/api/ai-copilot/stream',
    'clearSessionApiUrl' => '/admin/api/ai-copilot/clear-session',
    'applyApiUrl' => '/admin/api/ai-copilot/apply',
    'revertApiUrl' => '/admin/api/ai-copilot/revert',
    'csrfToken' => $headerCsrfToken,
    'securityPreset' => $config->get('security_preset') ?: 'config_only',
    'dataPrivacyLevel' => $config->get('data_privacy_level') ?: 'structure_only',
    'isProduction' => $isProduction,
    'allowProductionMutation' => (bool) $config->get('allow_production_mutation'),
  ];
}

/**
 * Implements hook_help().
 */
function ai_copilot_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.ai_copilot':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Drupal AI Copilot is an in-admin developer-mode AI assistant providing contrib-first, config-first, and patch-not-rewrite architecture guidance.') . '</p>';
      return $output;
  }
}
